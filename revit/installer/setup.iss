; Omar Khamis Revit Library — installer (built by .github/workflows/revit-build.yml)
; files.iss is generated by the workflow with one line per Revit version that built successfully.
#define AppVer GetEnv("OKR_VERSION")
#if AppVer == ""
  #define AppVer "1.0.0"
#endif

[Setup]
AppId={{D36BBDA6-CF83-50F1-BAB5-8B8F4C6E5CAA}
AppName=Omar Khamis Revit Library
AppVerName=Omar Khamis Revit Library {#AppVer}
AppVersion={#AppVer}
AppPublisher=Eng. Omar Khamis
AppPublisherURL=https://okl-admin.arch-omar-khames.workers.dev/buy
AppContact=01005433170
DefaultDirName={userappdata}\OmarKhamisRevit
DisableDirPage=yes
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
OutputDir=..\setup
OutputBaseFilename=OmarKhamis_Revit_Setup
Compression=lzma2
SolidCompression=yes
WizardStyle=modern
UninstallDisplayName=Omar Khamis Revit Library
CloseApplications=no
LanguageDetectionMethod=none

[Messages]
WelcomeLabel1=مكتبة م. عمر خميس لريفيت
WelcomeLabel2=هيتم تثبيت المكتبة على كل إصدارات ريفيت الموجودة على جهازك (من 2017 لحد 2027).%n%nاقفل ريفيت قبل ما تكمل.
FinishedLabel=تم التثبيت ✓%n%nافتح ريفيت هتلاقي تبويب «م. عمر خميس» في الشريط اللي فوق.

[Files]
#include "files.iss"

[UninstallDelete]
Type: filesandordirs; Name: "{userappdata}\OmarKhamisRevit\versions"

[Code]
function RevitInstalled(Year: String): Boolean;
begin
  Result := DirExists(ExpandConstant('{commonpf64}\Autodesk\Revit ') + Year)
         or DirExists(ExpandConstant('{commonappdata}\Autodesk\Revit\Addins\') + Year)
         or RegKeyExists(HKLM64, 'SOFTWARE\Autodesk\Revit\' + Year)
         or RegKeyExists(HKLM64, 'SOFTWARE\Autodesk\Revit\Autodesk Revit ' + Year);
end;

function AnyRevit(): Boolean;
var y: Integer;
begin
  Result := False;
  for y := 2017 to 2027 do
    if RevitInstalled(IntToStr(y)) then Result := True;
end;

function ShouldInstall(Year: String): Boolean;
begin
  Result := RevitInstalled(Year) or (not AnyRevit());
end;

function InitializeSetup(): Boolean;
begin
  Result := True;
  if not AnyRevit() then
    Result := MsgBox('مش لاقي ريفيت على الجهاز ده (2017 – 2027).' + #13#10 + 'تحب تكمل التثبيت برضو؟', mbConfirmation, MB_YESNO) = IDYES;
end;
